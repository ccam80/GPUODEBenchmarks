*.exe

# Ignore virtual environment directories starting with `venv` anywhere
venv*/
**/venv*/

# Suite environments are shared into worktrees as symlinks (worktree_setup.py),
# and GPU_ODE_CUBIE_MLIR/venv links at the CUBIE venv in every checkout. Git
# sees a symlink as a file, so the directory patterns above do not cover them.
GPU_ODE_*/venv

# Ignore cubie clone directories in setup folders
GPU_ODE_CUBIE/cubie/
GPU_ODE_CUBIE_MLIR/cubie/

# Cubie generated-code caches (one dir per system name); a symlink in worktrees
/generated

# Local assistant/tool state
.claude/
.omc/

# Python cache
__pycache__/
*.pyc
*.pyo

# Setup logs written next to the setup scripts
/julia_setup.log
/cubie_setup.log

# MLIR codegen output (regenerated by the CUBIE_MLIR benchmarks)
GPU_ODE_CUBIE_MLIR/generated/

# Myokit CUDA export output (regenerated by the benchmark adapter)
GPU_ODE_MYOKIT_CUDA/generated/

# Regenerated from the per-repeat logs by runner_scripts/collect_samples.py
/data/master_run_times.csv

# Local benchmark result sets
/data/cubie_julia_overlap/
/data/numerical_equivalence/cubie_pre626_jul16/

# Orchestrator run logs
/logs/

golden_ring_modulator.log*

# MPGOS cached builds (a symlink in worktrees) and generated Myokit models
GPU_ODE_MPGOS/build_cache
GPU_ODE_MYOKIT_CUDA/models/generated/
