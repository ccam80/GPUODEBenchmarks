# plots
*.exe

/data
# But allow the README in the numerical comparison directory
!/data/numerical/
!/data/numerical/README.md
# Ignore the actual CSV data files
/data/numerical/*.csv

# Ignore virtual environment directories starting with `venv` anywhere
venv*/
**/venv*/

# Ignore cubie clone directories in setup folders
GPU_ODE_CUBIE/cubie/
GPU_ODE_CUBIE_MLIR/cubie/

# Cubie generated-code caches (one dir per system name)
/generated/*/

# Local assistant/tool state
.claude/
.omc/

# Python cache
__pycache__/
*.pyc
*.pyo
/Manifest.toml
/Project.toml
